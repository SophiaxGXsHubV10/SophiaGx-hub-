local texto = "bailão"

if setclipboard then
    setclipboard(texto)
elseif toclipboard then
    toclipboard(texto)
elseif set_clipboard then
    set_clipboard(texto)
elseif Clipboard and Clipboard.set then
    Clipboard.set(texto)
elseif syn and syn.write_clipboard then
    syn.write_clipboard(texto)
else
    -- Se falhar, avisa no chat do jogo para sabermos se o script rodou
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Erro",
        Text = "O Delta não reconheceu nenhuma função de cópia.",
        Duration = 5
    })
end
