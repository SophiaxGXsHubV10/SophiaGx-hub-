-- DETECÇÃO OTIMIZADA
local function obterMonstros()
    local lista = {}
    if workspace:FindFirstChild("Monsters") then
        for _, m in pairs(workspace.Monsters:GetChildren()) do table.insert(lista, m) end
    end
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Name ~= LP.Name and not v:FindFirstChild("CarriedBy") then
            table.insert(lista, v)
        end
    end
    return lista
end

-- LOOP RENDERSTEPPED (Focado em Física e Hitbox)
RunService.RenderStepped:Connect(function()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = LP.Character.HumanoidRootPart

    if state.autoPullBodies and workspace:FindFirstChild("Interactables") then
        for _, v in pairs(workspace.Interactables:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and not v:FindFirstChild("ProductPriceTag") then
                v.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0, 0, -2.5)
            end
        end
    end

    local monstros = obterMonstros()
    for _, m in pairs(monstros) do
        local eRoot = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
        if eRoot and eRoot:IsA("BasePart") then
            local dist = (root.Position - eRoot.Position).Magnitude
            if state.killAura and dist < 45 then
                eRoot.Size = Vector3.new(25, 25, 25)
                eRoot.Transparency = 0.7
                eRoot.CanCollide = false
            else
                if eRoot.Size.X > 5 then 
                    eRoot.Size = Vector3.new(2, 2, 1) 
                    eRoot.Transparency = 1 
                end
            end
        end
    end

    if state.noclip then
        for _, v in pairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end
end)

-- LOOP HEARTBEAT (Executa rajadas de eventos remotos acoplados aos frames físicos)
RunService.Heartbeat:Connect(function()
    if state.killAura and LP.Character and ZAP then
        local root = LP.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local monstros = obterMonstros()
            for _, m in pairs(monstros) do
                local eRoot = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
                if eRoot then
                    local dist = (root.Position - eRoot.Position).Magnitude
                    if dist < 45 then
                        -- Loop interno forçado: dispara o mesmo sinal 3 vezes consecutivas por frame físico
                        for i = 1, 3 do
                            pcall(function() ZAP.meleeAttack.fire({monsters = {m}, civilians = {}, activeSlot = 1}) end)
                            pcall(function() ZAP.meleeAttack.fire({monsters = {m}, civilians = {}, activeSlot = 2}) end)
                            pcall(function() ZAP.meleeAttack:FireServer({monsters = {m}, civilians = {}, activeSlot = 2}) end)
                        end
                    end
                end
            end
        end
    end
end)
