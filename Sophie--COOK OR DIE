local cacheMonstros = {}
local tempoCache = 0

local function ehChefe(m)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.MaxHealth >= 500 then return true end
    local nome = m.Name:lower()
    return nome:find("boss") or nome:find("chefe") or nome:find("giant") or nome:find("titan")
end

local function atualizarCacheMonstros()
    cacheMonstros = {}
    pcall(function()
        if workspace:FindFirstChild("Monsters") then
            for _,m in pairs(workspace.Monsters:GetChildren()) do
                if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                    local eRoot = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
                    if eRoot then
                        table.insert(cacheMonstros, {
                            model = m,
                            root = eRoot,
                            chefe = ehChefe(m)
                        })
                    end
                end
            end
        end
        for _,v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v~=LP.Character and not Players:GetPlayerFromCharacter(v) then
                local eRoot = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")
                if eRoot then
                    local jaExiste = false
                    for _,d in ipairs(cacheMonstros) do
                        if d.model == v then jaExiste = true break end
                    end
                    if not jaExiste then
                        table.insert(cacheMonstros, {
                            model = v,
                            root = eRoot,
                            chefe = ehChefe(v)
                        })
                    end
                end
            end
        end
    end)
end

local acumuladorAtaques = 0
local tempoDesdeCache = 0

_G.KAThread = RunService.Heartbeat:Connect(function(deltaTime)
    pcall(function()
        if state.kaModo == 0 or not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") or not ZAP then
            acumuladorAtaques = 0
            return
        end

        local root = LP.Character.HumanoidRootPart
        local minhaPos = root.Position

        local porSeg, alcance
        if state.kaModo == 1 then
            porSeg = KA_NORMAL_POR_SEG
            alcance = DISTANCIA_MAX
        elseif state.kaModo == 2 then
            porSeg = KA_BOSS_POR_SEG
            alcance = DISTANCIA_MAX
        else
            porSeg = KA_DEFESA_POR_SEG
            alcance = DISTANCIA_DEFESA
        end

        tempoDesdeCache = tempoDesdeCache + deltaTime
        if tempoDesdeCache >= CACHE_ATUALIZAR then
            atualizarCacheMonstros()
            tempoDesdeCache = 0
        end

        acumuladorAtaques = acumuladorAtaques + (porSeg * deltaTime)
        local qtdAtacar = math.floor(acumuladorAtaques)
        acumuladorAtaques = acumuladorAtaques - qtdAtacar

        if qtdAtacar <= 0 then return end

        local alvosProximos = {}
        for _, dados in ipairs(cacheMonstros) do
            local m = dados.model
            local eRoot = dados.root
            if eRoot and eRoot.Parent and m.Parent then
                local dist = (minhaPos - eRoot.Position).Magnitude
                if dist < alcance then
                    table.insert(alvosProximos, {
                        dados = dados,
                        dist = dist
                    })
                end
            end
        end

        table.sort(alvosProximos, function(a, b)
            if a.dados.chefe ~= b.dados.chefe then
                return a.dados.chefe
            end
            return a.dist < b.dist
        end)

        local processados = 0
        for _, alvo in ipairs(alvosProximos) do
            if processados >= MAX_ALVOS_POR_TICK then break end
            processados = processados + 1

            local m = alvo.dados.model
            for _ = 1, qtdAtacar do
                pcall(function() ZAP.meleeAttack.fire({monsters={m}, civilians={}, activeSlot=1}) end)
            end
        end
    end)
end)

table.insert(_G.InsanoHeartbeats, _G.KAThread)

_G.InsanoRender = RunService.Heartbeat:Connect(function()
    pcall(function()
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        local root = LP.Character.HumanoidRootPart

        if state.autoPullBodies and workspace:FindFirstChild("Interactables") then
            for _,v in pairs(workspace.Interactables:GetChildren()) do
                if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                    v.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0,0,-2.5)
                end
            end
        end

        if state.noclip then
            for _,v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

